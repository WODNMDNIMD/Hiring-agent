# AI provider: mock, deepseek, openai
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Enterprise WeChat group robot webhook. Default is mock mode.
WECOM_NOTIFY_ENABLED=false
WECOM_WEBHOOK_URL=
WECOM_MESSAGE_TYPE=markdown
WECOM_TIMEOUT_SECONDS=10

# Tencent Docs mode: mock or api. API implementation is intentionally isolated.
TENCENT_DOCS_MODE=mock
TENCENT_DOCS_MOCK_PATH=data/mock_tencent_docs.csv
TENCENT_DOCS_FILE_ID=
TENCENT_DOCS_ACCESS_TOKEN=

DATABASE_URL=data/recruitflow.db
